{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Development",
      "type": "npm",
      "script": "start",
      "problemMatcher": []
    },
    {
      "label": "Build Windows",
      "type": "npm",
      "script": "build:win",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Clean Build",
      "type": "shell",
      "command": "rm -rf dist/ node_modules/",
      "windows": {
        "command": "rd /s /q dist node_modules"
      }
    }
  ]
}